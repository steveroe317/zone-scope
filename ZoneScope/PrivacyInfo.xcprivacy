<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ZoneScope does not track users: no network layer, no accounts, no analytics,
	     no advertising identifiers, and nothing leaves the device. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- Health data is read from HealthKit and rendered on device. It is never
	     transmitted off the device, so under Apple's definition it is not "collected"
	     and no data types are declared here. The derived workout cache is stored
	     locally with complete file protection and excluded from iCloud backup. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- @AppStorage in ContentView stores two UI preferences: which zones are
			     visible, and the Trends granularity. Both are read and written only by
			     this app. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
